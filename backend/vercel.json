{
  "functions": {
    "api/ai-research/[provider].ts": {
      "maxDuration": 30
    },
    "api/share/upload-token.ts": {
      "maxDuration": 30
    },
    "api/share/create.ts": {
      "maxDuration": 30
    },
    "api/share/stream.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/share/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
